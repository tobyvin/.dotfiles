#!/bin/sh
# shellcheck disable=SC2012

if [ ! -t 0 ]; then
	set -- "$@" "$(cat)"
elif [ $# -eq 0 ]; then
	ls -t -1 "$XDG_STATE_HOME"/mpv/watch_later/* | while read -r file; do
		awk -f - "$file" <<-"EOF"
			NR == 1 && /^# / && !/^# redirect entry/ { url = $0 }
			END {
				if (NR > 1 && sub(/^# /, "", url) && sub(/^# title: /, "")) {
					printf "%s: %s\n", url, $0
				}
			}
		EOF
	done

	exit 0
fi

url="$(printf '%s\n' "$1" | grep -Po '^.+?(?=\: )')"
swaymsg exec -- mpv --msg-level=all=no "$url"
