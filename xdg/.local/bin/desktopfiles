#!/bin/sh

set -- "$@" '--'
for arg; do
	shift
	case $arg in
	*.desktop) glob="$arg" ;;
	--) break ;;
	*) set -- "$@" "$arg" ;;
	esac
done

trap 'rm -f $tmp $tmp2' INT TERM EXIT

[ -n "${IFS+set}" ] && ifs=$IFS
IFS=:
for data_dir in $XDG_DATA_HOME $XDG_DATA_DIRS; do
	app_dir="${data_dir%/}/applications"
	if [ -d "$app_dir" ]; then
		paths="$paths $app_dir"
	fi
done
[ -n "${ifs+set}" ] && IFS=$ifs

tmp=$(mktemp)
tmp2=$(mktemp)

# shellcheck disable=SC2086
fd -0 --extension=desktop "${glob:-.}" $paths >"$tmp"

for arg; do
	<"$tmp" xargs -0 rg -0 "$arg" --files-with-matches >"$tmp2"
	cat "$tmp2" >"$tmp"
done

<"$tmp2" xargs -l -0
